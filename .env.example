# Copie para .env e troque os valores. O .env NÃO vai para o repositório.

# Senha do usuário "ticket" do PostgreSQL (usada pelos três serviços).
POSTGRES_PASSWORD=troque-esta-senha

# Chave de assinatura do JWT. Mínimo de 32 caracteres. Gere uma com:
#   openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria-com-32-ou-mais-caracteres

# Portas publicadas no host (opcional).
FRONTEND_PORT=80
GATEWAY_PORT=8080
POSTGRES_HOST_PORT=5433
