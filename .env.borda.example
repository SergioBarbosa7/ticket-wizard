# VM-A (borda). Copie para .env.borda. O arquivo real NÃO vai para o repositório.

# Chave de assinatura do JWT. Mínimo de 32 caracteres. Gere uma com:
#   openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria-com-32-ou-mais-caracteres

# IP INTERNO (da VPC) da VM-B, onde rodam os serviços gRPC.
VM_INTERNA_IP=10.10.0.10

# Opcional.
FRONTEND_PORT=80
GATEWAY_PORT=8080
